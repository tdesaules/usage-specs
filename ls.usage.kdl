name "ls"
bin "ls"
about "list directory contents"
author "GNU coreutils"

arg "<files>..."

flag "-a --all" help="do not ignore entries starting with ."
flag "-A --almost-all" help="do not list implied . and .."
flag "--author" help="with -l, print the author of each file"
flag "-b --escape" help="print C-style escapes for nongraphic characters"
flag "--block-size <SIZE>" help="with -l, scale sizes by SIZE when printing them"
flag "-B --ignore-backups" help="do not list implied entries ending with ~"
flag "-c" help="with -lt: sort by ctime; with -l: show ctime"
flag "-C" help="list entries by columns"
flag "--color <WHEN>" help="colorize the output" {
    choices "always" "auto" "never"
}
flag "-d --directory" help="list directories themselves, not their contents"
flag "-D --dired" help="generate output designed for Emacs' dired mode"
flag "-f" help="do not sort, enable -aU, disable -ls --color"
flag "-F --classify" help="append indicator (one of */=>@|) to entries"
flag "--file-type" help="likewise, except do not append '*'"
flag "--format <WORD>" help="across -x, commas -m, horizontal -x, long -l, single-column -1, verbose -l, vertical -C" {
    choices "across" "commas" "horizontal" "long" "single-column" "verbose" "vertical"
}
flag "--full-time" help="like -l --time-style=full-iso"
flag "-g" help="like -l, but do not list owner"
flag "--group-directories-first" help="group directories before files"
flag "-G --no-group" help="in a long listing, don't print group names"
flag "-h --human-readable" help="with -l and -s, print sizes like 1K 234M 2G etc."
flag "--si" help="likewise, but use powers of 1000 not 1024"
flag "-H --dereference-command-line" help="follow symbolic links listed on the command line"
flag "--dereference-command-line-symlink-to-dir" help="follow each command line symbolic link that points to a dir"
flag "--hide <PATTERN>" help="do not list implied entries matching shell PATTERN"
flag "--hyperlink <WHEN>" help="hyperlink file names" {
    choices "always" "auto" "never"
}
flag "-i --inode" help="print the index number of each file"
flag "-I --ignore <PATTERN>" help="do not list implied entries matching shell PATTERN"
flag "-k --kibibytes" help="default to 1024-byte blocks for disk usage"
flag "-l" help="use a long listing format"
flag "-L --dereference" help="when showing file information for a symbolic link, show information for the file the link references"
flag "-m" help="fill width with a comma separated list of entries"
flag "-n --numeric-uid-gid" help="like -l, but list numeric user and group IDs"
flag "-N --literal" help="print entry names without quoting"
flag "-o" help="like -l, but do not list group information"
flag "-p --indicator-style <WORD>" help="append indicator with style WORD to entry names"
flag "-q --hide-control-chars" help="print ? instead of nongraphic characters"
flag "--show-control-chars" help="show nongraphic characters as-is"
flag "-Q --quote-name" help="enclose entry names in double quotes"
flag "--quoting-style <WORD>" help="use quoting style WORD for entry names"
flag "-r --reverse" help="reverse order while sorting"
flag "-R --recursive" help="list subdirectories recursively"
flag "-s --size" help="print the allocated size of each file, in blocks"
flag "-S" help="sort by file size, largest first"
flag "--sort <WORD>" help="sort by WORD instead of name" {
    choices "none" "size" "time" "version" "extension"
}
flag "--time <WORD>" help="with -l, show time as WORD instead of default modification time" {
    choices "atime" "access" "use" "ctime" "status"
}
flag "--time-style <STYLE>" help="with -l, show times using style STYLE"
flag "-t" help="sort by time, newest first"
flag "-T --tabsize <COLS>" help="assume tab stops at each COLS instead of 8"
flag "-u" help="with -lt: sort by, and show, access time"
flag "-U" help="do not sort; list entries in directory order"
flag "-v" help="natural sort of (version) numbers within text"
flag "-w --width <COLS>" help="set output width to COLS"
flag "-x" help="list entries by lines instead of by columns"
flag "-X" help="sort alphabetically by entry extension"
flag "-Z --context" help="print any security context of each file"
flag "-1" help="list one file per line"
flag "--help" help="display this help and exit"
flag "--version" help="output version information and exit"
